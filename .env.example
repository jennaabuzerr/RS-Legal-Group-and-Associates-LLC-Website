# Copy to .env.local for local dev. Set the same values in Vercel > Project > Settings > Environment Variables.
# Web3Forms access key (free at https://web3forms.com, created with the firm's email address)
VITE_WEB3FORMS_KEY=
# Public site URL, no trailing slash. Used for canonical URLs, Open Graph and sitemap.xml.
VITE_SITE_URL=https://www.example.com
